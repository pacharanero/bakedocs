#
# Check the syntax of every executable Bash script in the project.

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

for script in bakedocs s/* tests/*; do
  [[ -f "$script" && -x "$script" ]] || continue
  bash -n "$script"
done

printf 'Shell syntax checks passed\n'
