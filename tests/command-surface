#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Marcus Baw
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/bakedocs-test.XXXXXXXX")"
trap 'rm -rf "$temp_dir"' EXIT

fail() {
  printf 'command-surface test failed: %s\n' "$1" >&2
  exit 1
}

assert_equal() {
  local expected="$1"
  local actual="$2"
  local context="$3"
  [[ "$actual" == "$expected" ]] || fail "$context: expected '$expected', got '$actual'"
}

assert_contains() {
  local needle="$1"
  local file="$2"
  grep -Fq "$needle" "$file" || fail "$file does not contain: $needle"
}

brand_root="$temp_dir/brand root"
work_dir="$temp_dir/work space"
mkdir -p "$brand_root/test/assets" "$work_dir"

cat > "$brand_root/test/brand.yml" <<'EOF'
brand-name: "Test Organisation"
logo: "assets/logo.svg"
EOF

cat > "$brand_root/test/tokens.css" <<'EOF'
:root {
  --brand-primary: #123456;
  --brand-accent: #2878a0;
  --brand-highlight: #765432;
  --brand-surface: #f4f4f4;
  --brand-ink: #111111;
  --brand-heading-font: sans-serif;
  --brand-body-font: sans-serif;
  --brand-local-resource: url(assets/logo.svg);
}
EOF

cat > "$brand_root/test/assets/logo.svg" <<'EOF'
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 10" role="img" aria-label="Test logo">
  <rect width="20" height="10" fill="#123456"/>
</svg>
EOF

cp "$root/fixtures/document.md" "$work_dir/report source.md"
cp "$root/fixtures/slides.md" "$work_dir/slides source.md"
cp "$brand_root/test/assets/logo.svg" "$work_dir/local-media.svg"
cat >> "$work_dir/slides source.md" <<'EOF'

# Local media

![Local media][local-media]

[local-media]: local-media.svg

# Local background {data-background-image="local-media.svg"}
EOF

"$root/bakedocs" > "$temp_dir/help.txt"
assert_contains 'bakedocs pdf <SOURCE> <BRAND-ID>' "$temp_dir/help.txt"
assert_equal 'bakedocs 0.1.0-dev' "$("$root/bakedocs" --version)" '--version output'
assert_equal 'bakedocs 0.1.0-dev' "$("$root/bakedocs" version)" 'version command output'
assert_equal 'test' "$("$root/bakedocs" brands list --brands-dir "$brand_root")" 'explicit brand list'
"$root/bakedocs" brands show test --brands-dir "$brand_root" > "$temp_dir/brand.txt"
assert_contains 'brand-name: "Test Organisation"' "$temp_dir/brand.txt"

config_home="$temp_dir/home"
mkdir -p "$config_home/.config/bakedocs/brands"
cp -R "$brand_root/test" "$config_home/.config/bakedocs/brands/test"
actual_brands="$(cd "$work_dir" && env -u XDG_CONFIG_HOME HOME="$config_home" "$root/bakedocs" brands list)"
assert_equal 'test' "$actual_brands" 'HOME config brand discovery'

html_output="$work_dir/rendered report.html"
actual_output="$("$root/bakedocs" html "$work_dir/report source.md" test --brands-dir "$brand_root" --offline --output "$html_output")"
assert_equal "$html_output" "$actual_output" 'HTML output path'
[[ -s "$html_output" ]] || fail 'HTML output is missing or empty'

mkdir -p "$temp_dir/bin"
ln -s "$root/bakedocs" "$temp_dir/bin/bakedocs"
symlink_output="$work_dir/symlinked.html"
"$temp_dir/bin/bakedocs" html "$work_dir/report source.md" test \
  --brands-dir "$brand_root" --offline --output "$symlink_output" > /dev/null
[[ -s "$symlink_output" ]] || fail 'symlinked invocation output is missing or empty'
assert_contains '<main>' "$html_output"
assert_contains '<html lang="en-GB">' "$html_output"
assert_contains '#123456' "$html_output"
assert_contains 'data:image/svg+xml' "$html_output"

values_one="$work_dir/values one.yml"
cat > "$values_one" <<'EOF'
provider:
  name: "First Provider"
  company-number: "12345"
engagement:
  label: "Draft"
local: "Values value"
multiline: |
  line one
  line two
paragraphs: |-
  first paragraph

  second paragraph
rich: '<script>alert("value")</script> *emphasis*'
unsafe: "supersecrettoken:payload"
recursive:
  first: "{{ recursive.second }}"
  second: "resolved recursively"
EOF
values_two="$work_dir/values-two.json"
cat > "$values_two" <<'EOF'
{"engagement":{"label":"Final"}}
EOF
interpolation_source="$work_dir/interpolation.md"
cat > "$interpolation_source" <<'EOF'
---
title: "{{ engagement.label }}"
local: "Source value"
language: "en-GB"
---

# Welcome {{ provider.name }}

Company {{ provider.company-number }}. Organisation {{ brand-name }}. Local {{ local }}.

Multiline: {{ multiline }}.

Paragraphs: {{ paragraphs }}.

Recursive: {{ recursive.first }}.

Literal: {{{{ provider.name }}}}.

Inline code: `{{ missing.code }}`.

```text
{{ missing.block }}
```

[Registry {{ provider.name }}](https://example.test/{{ provider.company-number }} "Record {{ provider.company-number }}")

[Encoded](https://example.test/a%20b/%7Braw%7D/{{ provider.company-number }})

[Literal destination](https://example.test/{{{{ provider.company-number }}}})
EOF
interpolation_output="$work_dir/interpolation.html"
"$root/bakedocs" html "$interpolation_source" test --brands-dir "$brand_root" \
  --values "$values_one" --values="$values_two" --offline --output "$interpolation_output" > /dev/null
assert_contains '<title>Final</title>' "$interpolation_output"
assert_contains 'Welcome First Provider' "$interpolation_output"
assert_contains 'Company 12345. Organisation Test Organisation.' "$interpolation_output"
assert_contains 'Local Source' "$interpolation_output"
assert_contains 'Multiline: line one line two.' "$interpolation_output"
assert_contains 'Paragraphs: first paragraph second paragraph.' "$interpolation_output"
assert_contains 'Recursive: resolved recursively.' "$interpolation_output"
assert_contains 'Literal: {{ provider.name }}.' "$interpolation_output"
assert_contains '{{ missing.code }}' "$interpolation_output"
assert_contains '{{ missing.block }}' "$interpolation_output"
assert_contains 'href="https://example.test/12345"' "$interpolation_output"
assert_contains 'title="Record 12345"' "$interpolation_output"
assert_contains 'href="https://example.test/a%20b/%7Braw%7D/12345"' "$interpolation_output"
assert_contains 'href="https://example.test/{{ provider.company-number }}"' "$interpolation_output"

replacement_values="$work_dir/replacement-values.yml"
cat > "$replacement_values" <<'EOF'
provider:
  name: "Replacement Provider"
EOF
replacement_source="$work_dir/replacement.md"
cat > "$replacement_source" <<'EOF'
---
title: "Replacement"
---

{{ provider.name }} {{ provider.company-number }}
EOF
if "$root/bakedocs" html "$replacement_source" test --brands-dir "$brand_root" \
  --values "$values_one" --values "$replacement_values" --offline --output "$work_dir/replacement.html" > /dev/null 2> "$temp_dir/replacement-error.txt"; then
  fail 'later values file unexpectedly retained an earlier nested key'
fi
assert_contains 'unresolved metadata path: provider.company-number' "$temp_dir/replacement-error.txt"

interpolation_slides="$work_dir/interpolation-slides.md"
cat > "$interpolation_slides" <<'EOF'
---
title: "{{ engagement.label }}"
language: "en-GB"
---

# {{ provider.name }}

Company {{ provider.company-number }}
EOF
interpolation_slides_output="$work_dir/interpolation-slides.html"
"$root/bakedocs" slides "$interpolation_slides" test --brands-dir "$brand_root" \
  --values "$values_one" --values "$values_two" --output "$interpolation_slides_output" > /dev/null
assert_contains '<title>Final</title>' "$interpolation_slides_output"
assert_contains 'First Provider' "$interpolation_slides_output"

rich_source="$work_dir/rich-value.md"
cat > "$rich_source" <<'EOF'
---
title: "Rich value"
---

{{ rich }}
EOF
rich_output="$work_dir/rich-value.html"
"$root/bakedocs" html "$rich_source" test --brands-dir "$brand_root" \
  --values "$values_one" --offline --output "$rich_output" > /dev/null
assert_contains '&lt;script&gt;alert' "$rich_output"
assert_contains '&lt;/script&gt; emphasis' "$rich_output"
if grep -Fq '<script>alert("value")</script>' "$rich_output"; then
  fail 'metadata interpolation emitted executable HTML'
fi
if grep -Fq '<em>emphasis</em>' "$rich_output"; then
  fail 'metadata interpolation reparsed a value as Markdown'
fi

missing_source="$work_dir/missing-interpolation.md"
cat > "$missing_source" <<'EOF'
---
title: "Missing values"
---

{{ missing.one }} and {{ missing.two }}
EOF
missing_output="$work_dir/missing-interpolation.html"
printf 'preserve\n' > "$missing_output"
if "$root/bakedocs" html "$missing_source" test --brands-dir "$brand_root" \
  --values "$values_one" --offline --output "$missing_output" > /dev/null 2> "$temp_dir/missing-values-error.txt"; then
  fail 'unresolved metadata interpolation unexpectedly succeeded'
fi
assert_contains 'unresolved metadata path: missing.one' "$temp_dir/missing-values-error.txt"
assert_contains 'unresolved metadata path: missing.two' "$temp_dir/missing-values-error.txt"
assert_equal 'preserve' "$(< "$missing_output")" 'failed interpolation output preservation'

malformed_source="$work_dir/malformed-interpolation.md"
cat > "$malformed_source" <<'EOF'
---
title: "Malformed value"
---

{{ provider.name | upper }}
EOF
if "$root/bakedocs" html "$malformed_source" test --brands-dir "$brand_root" \
  --values "$values_one" --offline --output "$work_dir/malformed.html" > /dev/null 2> "$temp_dir/malformed-interpolation-error.txt"; then
  fail 'malformed metadata interpolation unexpectedly succeeded'
fi
assert_contains 'malformed metadata placeholder' "$temp_dir/malformed-interpolation-error.txt"

unsafe_interpolation="$work_dir/unsafe-interpolation.md"
cat > "$unsafe_interpolation" <<'EOF'
---
title: "Unsafe value"
---

[Unsafe]({{ unsafe }})
EOF
if "$root/bakedocs" html "$unsafe_interpolation" test --brands-dir "$brand_root" \
  --values "$values_one" --offline --output "$work_dir/unsafe-interpolation.html" > /dev/null 2> "$temp_dir/unsafe-interpolation-error.txt"; then
  fail 'unsafe interpolated link unexpectedly succeeded'
fi
assert_contains 'unsafe link scheme is not permitted' "$temp_dir/unsafe-interpolation-error.txt"
if grep -Fq 'supersecrettoken' "$temp_dir/unsafe-interpolation-error.txt"; then
  fail 'resolved metadata value leaked through an unsafe-link diagnostic'
fi

cycle_values="$work_dir/cycle.yml"
cat > "$cycle_values" <<'EOF'
cycle-a: "{{ cycle-b }}"
cycle-b: "{{ cycle-a }}"
EOF
cycle_source="$work_dir/cycle.md"
cat > "$cycle_source" <<'EOF'
---
title: "Cycle"
---

{{ cycle-a }}
EOF
if "$root/bakedocs" html "$cycle_source" test --brands-dir "$brand_root" \
  --values "$cycle_values" --offline --output "$work_dir/cycle.html" > /dev/null 2> "$temp_dir/cycle-error.txt"; then
  fail 'cyclic metadata interpolation unexpectedly succeeded'
fi
assert_contains 'cyclic metadata path' "$temp_dir/cycle-error.txt"

expansion_values="$work_dir/expansion.yml"
cat > "$expansion_values" <<'EOF'
level-0: "1234567890"
level-1: "{{ level-0 }}{{ level-0 }}{{ level-0 }}{{ level-0 }}{{ level-0 }}{{ level-0 }}{{ level-0 }}{{ level-0 }}{{ level-0 }}{{ level-0 }}"
level-2: "{{ level-1 }}{{ level-1 }}{{ level-1 }}{{ level-1 }}{{ level-1 }}{{ level-1 }}{{ level-1 }}{{ level-1 }}{{ level-1 }}{{ level-1 }}"
level-3: "{{ level-2 }}{{ level-2 }}{{ level-2 }}{{ level-2 }}{{ level-2 }}{{ level-2 }}{{ level-2 }}{{ level-2 }}{{ level-2 }}{{ level-2 }}"
level-4: "{{ level-3 }}{{ level-3 }}{{ level-3 }}{{ level-3 }}{{ level-3 }}{{ level-3 }}{{ level-3 }}{{ level-3 }}{{ level-3 }}{{ level-3 }}"
level-5: "{{ level-4 }}{{ level-4 }}{{ level-4 }}{{ level-4 }}{{ level-4 }}{{ level-4 }}{{ level-4 }}{{ level-4 }}{{ level-4 }}{{ level-4 }}"
level-6: "{{ level-5 }}{{ level-5 }}{{ level-5 }}{{ level-5 }}{{ level-5 }}{{ level-5 }}{{ level-5 }}{{ level-5 }}{{ level-5 }}{{ level-5 }}"
EOF
expansion_source="$work_dir/expansion.md"
cat > "$expansion_source" <<'EOF'
---
title: "Expansion"
---

{{ level-6 }}
EOF
if "$root/bakedocs" html "$expansion_source" test --brands-dir "$brand_root" \
  --values "$expansion_values" --offline --output "$work_dir/expansion.html" > /dev/null 2> "$temp_dir/expansion-error.txt"; then
  fail 'oversized metadata expansion unexpectedly succeeded'
fi
assert_contains 'metadata expansion limit exceeded' "$temp_dir/expansion-error.txt"

secret='/etc/passwd'
logo_values="$work_dir/logo-values.yml"
printf 'secret: "%s"\n' "$secret" > "$logo_values"
logo_source="$work_dir/logo-interpolation.md"
cat > "$logo_source" <<'EOF'
---
title: "Logo interpolation"
logo: "{{ secret }}"
---

Body.
EOF
logo_output="$work_dir/logo-interpolation.html"
"$root/bakedocs" html "$logo_source" test --brands-dir "$brand_root" \
  --values "$logo_values" --offline --output "$logo_output" > /dev/null
assert_contains 'data:image/svg+xml' "$logo_output"
if grep -Fq 'root:x:' "$logo_output"; then
  fail 'values metadata replaced the brand-owned logo resource'
fi

metadata_image_values="$work_dir/metadata-image-values.yml"
cat > "$metadata_image_values" <<'EOF'
unused-image: '![leak](/etc/passwd)'
EOF
metadata_image_output="$work_dir/metadata-image.html"
printf 'preserve\n' > "$metadata_image_output"
if "$root/bakedocs" html "$work_dir/report source.md" test --brands-dir "$brand_root" \
  --values "$metadata_image_values" --offline --output "$metadata_image_output" > /dev/null 2> "$temp_dir/metadata-image-error.txt"; then
  fail 'metadata image unexpectedly succeeded'
fi
assert_contains 'images are not permitted in document metadata' "$temp_dir/metadata-image-error.txt"
assert_equal 'preserve' "$(< "$metadata_image_output")" 'metadata-image output preservation'
if grep -Fq '/etc/passwd' "$temp_dir/metadata-image-error.txt"; then
  fail 'metadata-image diagnostic leaked its resolved path'
fi

metadata_css_values="$work_dir/metadata-css-values.yml"
cat > "$metadata_css_values" <<'EOF'
css: "https://example.invalid/untrusted.css"
EOF
metadata_css_output="$work_dir/metadata-css.html"
"$root/bakedocs" slides "$work_dir/slides source.md" test --brands-dir "$brand_root" \
  --values "$metadata_css_values" --output "$metadata_css_output" > /dev/null
if grep -Fq 'untrusted.css' "$metadata_css_output"; then
  fail 'metadata CSS escaped the trusted Reveal style boundary'
fi

language_values="$work_dir/language-values.yml"
cat > "$language_values" <<'EOF'
secret-language: "super-secret-language-value"
EOF
language_source="$work_dir/language-interpolation.md"
cat > "$language_source" <<'EOF'
---
title: "Language"
language: "{{ secret-language }}"
---

Body.
EOF
if "$root/bakedocs" html "$language_source" test --brands-dir "$brand_root" \
  --values "$language_values" --offline --output "$work_dir/language.html" > /dev/null 2> "$temp_dir/language-error.txt"; then
  fail 'invalid interpolated language unexpectedly succeeded'
fi
assert_contains 'document language is invalid' "$temp_dir/language-error.txt"
if grep -Fq 'super-secret-language-value' "$temp_dir/language-error.txt"; then
  fail 'resolved metadata value leaked through a language diagnostic'
fi

supported_language_source="$work_dir/supported-language.md"
cat > "$supported_language_source" <<'EOF'
---
title: "Supported language"
language: "gl"
---

Body.
EOF
supported_language_output="$work_dir/supported-language.html"
"$root/bakedocs" html "$supported_language_source" test --brands-dir "$brand_root" \
  --offline --output "$supported_language_output" > /dev/null
assert_contains '<html lang="gl">' "$supported_language_output"

malformed_values="$work_dir/malformed-values.yml"
printf 'provider: [unterminated\n' > "$malformed_values"
if "$root/bakedocs" html "$interpolation_source" test --brands-dir "$brand_root" \
  --values "$malformed_values" --offline --output "$work_dir/malformed-values.html" > /dev/null 2> "$temp_dir/malformed-values-error.txt"; then
  fail 'malformed values input unexpectedly succeeded'
fi

if "$root/bakedocs" html "$interpolation_source" test --brands-dir "$brand_root" \
  --values "$work_dir/missing-values.yml" --offline --output "$work_dir/missing-values-file.html" > /dev/null 2> "$temp_dir/missing-values-file-error.txt"; then
  fail 'missing values input unexpectedly succeeded'
fi
assert_contains 'values input is not a readable file' "$temp_dir/missing-values-file-error.txt"

oversized_values="$work_dir/oversized-values.yml"
printf 'unused: "' > "$oversized_values"
dd if=/dev/zero bs=1024 count=1025 2> /dev/null | tr '\0' x >> "$oversized_values"
printf '"\n' >> "$oversized_values"
if "$root/bakedocs" html "$interpolation_source" test --brands-dir "$brand_root" \
  --values "$oversized_values" --offline --output "$work_dir/oversized-values.html" > /dev/null 2> "$temp_dir/oversized-values-error.txt"; then
  fail 'oversized values input unexpectedly succeeded'
fi
assert_contains 'values input exceeds the 1 MiB limit' "$temp_dir/oversized-values-error.txt"

default_output="$(cd "$work_dir" && "$root/bakedocs" html 'report source.md' test --brands-dir "$brand_root")"
assert_equal 'report source.html' "$default_output" 'default output path'
[[ -s "$work_dir/report source.html" ]] || fail 'default HTML output is missing or empty'

extensionless_output="$work_dir/rendered-without-extension"
actual_output="$("$root/bakedocs" html "$work_dir/report source.md" test --brands-dir "$brand_root" --output "$extensionless_output")"
assert_equal "$extensionless_output" "$actual_output" 'extensionless output path'
[[ -s "$extensionless_output" ]] || fail 'extensionless output is missing or empty'

if "$root/bakedocs" html "$work_dir/report source.md" test --brands-dir "$brand_root" --output "$work_dir/report source.md" > /dev/null 2> "$temp_dir/overwrite-error.txt"; then
  fail 'source overwrite unexpectedly succeeded'
fi
assert_contains 'output path would overwrite the source' "$temp_dir/overwrite-error.txt"

slides_output="$work_dir/rendered slides.html"
actual_output="$("$root/bakedocs" slides "$work_dir/slides source.md" test --brands-dir "$brand_root" --output "$slides_output")"
assert_equal "$slides_output" "$actual_output" 'slides output path'
assert_contains 'https://cdn.jsdelivr.net/npm/reveal.js@6.0.1/dist/reveal.mjs' "$slides_output"
assert_contains '#123456' "$slides_output"
assert_contains '<html lang="en-GB">' "$slides_output"
assert_contains 'data:image/svg+xml;base64,' "$slides_output"
if grep -Fq 'data-background-image="local-media.svg"' "$slides_output"; then
  fail 'slides output contains a source-relative background image'
fi
if grep -Fq "$brand_root" "$slides_output"; then
  fail 'slides output contains a machine-specific brand path'
fi

HOME="$work_dir" "$root/bakedocs" html "$work_dir/report source.md" test \
  --brands-dir "$brand_root" \
  "--output=~/tilde-output.html" > "$temp_dir/tilde-stdout.txt"
assert_equal "$work_dir/tilde-output.html" "$(< "$temp_dir/tilde-stdout.txt")" 'tilde output expansion'
[[ -s "$work_dir/tilde-output.html" ]] || fail 'tilde output is missing or empty'

if "$root/bakedocs" slides "$work_dir/slides source.md" test --brands-dir "$brand_root" --offline > /dev/null 2> "$temp_dir/offline-error.txt"; then
  fail 'offline slides unexpectedly succeeded'
fi
assert_contains 'slides require the pinned Reveal.js CDN' "$temp_dir/offline-error.txt"

if "$root/bakedocs" html "$work_dir/report source.md" unknown --brands-dir "$brand_root" > /dev/null 2> "$temp_dir/brand-error.txt"; then
  fail 'unknown brand unexpectedly succeeded'
fi
assert_contains "brand 'unknown' is missing brand.yml or tokens.css" "$temp_dir/brand-error.txt"

if "$root/bakedocs" html "$work_dir/missing.md" test --brands-dir "$brand_root" > /dev/null 2> "$temp_dir/source-error.txt"; then
  fail 'missing source unexpectedly succeeded'
fi
assert_contains 'source is not a readable file' "$temp_dir/source-error.txt"

mkdir -p "$temp_dir/empty-brands"
if "$root/bakedocs" brands list --brands-dir "$temp_dir/empty-brands" > /dev/null 2> "$temp_dir/empty-error.txt"; then
  fail 'empty explicit brand root unexpectedly fell back to another brand root'
fi
assert_contains 'no valid brand profiles found' "$temp_dir/empty-error.txt"

if "$root/bakedocs" check --brands-dir "$temp_dir/missing-brands" > "$temp_dir/missing-check.txt" 2> "$temp_dir/missing-check-error.txt"; then
  fail 'check unexpectedly accepted a missing explicit brand root'
fi
assert_contains 'explicit brand root does not exist' "$temp_dir/missing-check-error.txt"
if grep -Fq 'brands:' "$temp_dir/missing-check.txt"; then
  fail 'check fell through to discovered profiles after a missing explicit root'
fi

mkdir -p "$work_dir/client.v2"
cp "$work_dir/report source.md" "$work_dir/client.v2/report"
dotted_output="$(cd "$work_dir" && "$root/bakedocs" html client.v2/report test --brands-dir "$brand_root")"
assert_equal 'client.v2/report.html' "$dotted_output" 'dotted-directory default output'
[[ -s "$work_dir/client.v2/report.html" ]] || fail 'dotted-directory output is missing or empty'

cp "$work_dir/report source.md" "$work_dir/.report"
hidden_output="$(cd "$work_dir" && "$root/bakedocs" html .report test --brands-dir "$brand_root")"
assert_equal '.report.html' "$hidden_output" 'hidden-file default output'
[[ -s "$work_dir/.report.html" ]] || fail 'hidden-file output is missing or empty'

if "$root/bakedocs" html "$work_dir/report source.md" test --brands-dir "$brand_root" --output "$work_dir" > /dev/null 2> "$temp_dir/directory-error.txt"; then
  fail 'directory output unexpectedly succeeded'
fi
assert_contains 'output path is a directory' "$temp_dir/directory-error.txt"

cat > "$work_dir/remote-image.md" <<'EOF'
---
title: "Remote image"
---

![Remote image][remote-image]

[remote-image]: https://example.invalid/image.png
EOF
if "$root/bakedocs" html "$work_dir/remote-image.md" test --brands-dir "$brand_root" --offline --output "$work_dir/remote.html" > /dev/null 2> "$temp_dir/remote-error.txt"; then
  fail 'offline reference-style remote image unexpectedly succeeded'
fi
assert_contains 'remote image is not permitted in offline mode' "$temp_dir/remote-error.txt"

mkdir -p "$brand_root/remote-css"
cat > "$brand_root/remote-css/brand.yml" <<'EOF'
brand-name: "Remote CSS"
EOF
cat > "$brand_root/remote-css/tokens.css" <<'EOF'
:root {
  --brand-primary: #123456;
  background-image: url(https\3a //example.invalid/background.png);
}
EOF
if "$root/bakedocs" html "$work_dir/report source.md" remote-css --brands-dir "$brand_root" --offline --output "$work_dir/remote-css.html" > /dev/null 2> "$temp_dir/remote-css-error.txt"; then
  fail 'offline CSS URL unexpectedly succeeded'
fi
assert_contains 'remote brand assets are not permitted with --offline' "$temp_dir/remote-css-error.txt"

cat > "$work_dir/raw-html.md" <<'EOF'
---
title: "Raw HTML"
---

<script>document.body.dataset.executed = "true";</script>

```{=html}
<script>document.body.dataset.rawAttributeExecuted = "true";</script>
```
EOF
"$root/bakedocs" html "$work_dir/raw-html.md" test --brands-dir "$brand_root" --output "$work_dir/raw-html.html" > /dev/null
if grep -Fq '<script>document.body.dataset.' "$work_dir/raw-html.html"; then
  fail 'source raw HTML remained executable in document output'
fi

cat > "$work_dir/untitled.md" <<'EOF'
# Untitled source
EOF
